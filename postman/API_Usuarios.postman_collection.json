{
  "info": {
    "name": "API Usuarios",
    "description": "Colección de pruebas para la API REST de usuarios (Node.js + Express + PostgreSQL).\n\nIncluye los 5 endpoints CRUD y los casos de error (400, 404, 409).\n\nAntes de usarla, levanta el servidor con `npm run dev`.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "0. GET / (bienvenida)",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/",
          "host": ["{{baseUrl}}"],
          "path": [""]
        },
        "description": "Ruta raíz. Devuelve el nombre de la API, su versión y los endpoints disponibles."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Responde 200 OK', function () {",
              "    pm.response.to.have.status(200);",
              "});"
            ]
          }
        }
      ],
      "response": []
    },
    {
      "name": "1. POST /usuarios (crear) -> 201",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n    \"nombre\": \"Carlos\",\n    \"apellido\": \"Vera\",\n    \"email\": \"carlos.vera@ejemplo.com\",\n    \"telefono\": \"0966777888\"\n}",
          "options": { "raw": { "language": "json" } }
        },
        "url": {
          "raw": "{{baseUrl}}/usuarios",
          "host": ["{{baseUrl}}"],
          "path": ["usuarios"]
        },
        "description": "Crea un usuario nuevo. Devuelve 201 Created y el registro insertado."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Responde 201 Created', function () {",
              "    pm.response.to.have.status(201);",
              "});",
              "",
              "pm.test('Devuelve el usuario creado', function () {",
              "    var json = pm.response.json();",
              "    pm.expect(json.ok).to.eql(true);",
              "    pm.expect(json.data).to.have.property('id');",
              "});"
            ]
          }
        }
      ],
      "response": []
    },
    {
      "name": "2. GET /usuarios (listar) -> 200",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/usuarios",
          "host": ["{{baseUrl}}"],
          "path": ["usuarios"]
        },
        "description": "Devuelve todos los usuarios ordenados por id."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Responde 200 OK', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test('data es un arreglo', function () {",
              "    pm.expect(pm.response.json().data).to.be.an('array');",
              "});"
            ]
          }
        }
      ],
      "response": []
    },
    {
      "name": "3. GET /usuarios/1 (por id) -> 200",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/usuarios/1",
          "host": ["{{baseUrl}}"],
          "path": ["usuarios", "1"]
        },
        "description": "Devuelve un único usuario por su id."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Responde 200 OK', function () {",
              "    pm.response.to.have.status(200);",
              "});"
            ]
          }
        }
      ],
      "response": []
    },
    {
      "name": "4. PUT /usuarios/1 (actualizar) -> 200",
      "request": {
        "method": "PUT",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n    \"nombre\": \"Ana\",\n    \"apellido\": \"Pérez\",\n    \"email\": \"ana.perez@ejemplo.com\",\n    \"telefono\": \"0999000111\"\n}",
          "options": { "raw": { "language": "json" } }
        },
        "url": {
          "raw": "{{baseUrl}}/usuarios/1",
          "host": ["{{baseUrl}}"],
          "path": ["usuarios", "1"]
        },
        "description": "Actualiza todos los datos del usuario con id 1."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Responde 200 OK', function () {",
              "    pm.response.to.have.status(200);",
              "});"
            ]
          }
        }
      ],
      "response": []
    },
    {
      "name": "5. DELETE /usuarios/1 (eliminar) -> 200",
      "request": {
        "method": "DELETE",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/usuarios/1",
          "host": ["{{baseUrl}}"],
          "path": ["usuarios", "1"]
        },
        "description": "Elimina el usuario con id 1 y devuelve el registro eliminado."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Responde 200 OK', function () {",
              "    pm.response.to.have.status(200);",
              "});"
            ]
          }
        }
      ],
      "response": []
    },
    {
      "name": "ERROR 400 - POST sin campos obligatorios",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n    \"nombre\": \"Solo el nombre\"\n}",
          "options": { "raw": { "language": "json" } }
        },
        "url": {
          "raw": "{{baseUrl}}/usuarios",
          "host": ["{{baseUrl}}"],
          "path": ["usuarios"]
        },
        "description": "Faltan apellido y email -> 400 Bad Request."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Responde 400 Bad Request', function () {",
